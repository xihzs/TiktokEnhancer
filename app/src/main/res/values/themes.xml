<resources>
    <style name="Theme.TikTokRegion" parent="Theme.Material3.Dark.NoActionBar">

        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_card_secondary</item>
        <item name="colorPrimary">@color/accent_silver</item>
        <item name="colorOnPrimary">#0D0E11</item>
        <item name="colorSecondary">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="DialogDarkTheme" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:colorBackground">@color/surface_card</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorPrimary">@color/accent_silver</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>
</resources>

